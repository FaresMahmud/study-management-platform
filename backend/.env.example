# Perfil ativo do Spring Boot (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Porta do Servidor Backend
SERVER_PORT=8080

# Produção (PostgreSQL Neon)
DATABASE_URL=jdbc:postgresql://seu-host-neon.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=seu_usuario_neon
SPRING_DATASOURCE_PASSWORD=sua_senha_neon

# Desenvolvimento Local (MySQL)
DB_URL=jdbc:mysql://localhost:3306/studyplatform?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=sua_senha_aqui

# Segurança (JWT)
JWT_SECRET=sua_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRATION=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174