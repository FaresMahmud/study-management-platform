# ==========================================
# STUDY MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION
# ==========================================

# Perfil ativo do Spring Boot (dev | prod)
# - Em dev: usa o banco local MySQL
# - Em prod: usa PostgreSQL no Neon Database via DATABASE_URL
SPRING_PROFILES_ACTIVE=dev

# Porta do Servidor Backend
SERVER_PORT=8080

# ==========================================
# PRODUÇÃO / NEON DATABASE (Perfil: prod)
# ==========================================
# Connection String fornecida pelo Neon Database (exige sslmode=require)
# Exemplo JDBC: jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://seu-host-neon.aws.neon.tech/neondb?sslmode=require
# Caso usuário/senha não estejam embutidos no DATABASE_URL:
SPRING_DATASOURCE_USERNAME=seu_usuario_neon
SPRING_DATASOURCE_PASSWORD=sua_senha_neon

# ==========================================
# DESENVOLVIMENTO LOCAL (Perfil: dev)
# ==========================================
DB_URL=jdbc:mysql://localhost:3306/studyplatform?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=sua_senha_local

# ==========================================
# SEGURANÇA & AUTENTICAÇÃO (JWT)
# ==========================================
# Chave secreta de no mínimo 32 caracteres (Gere uma chave segura para produção)
JWT_SECRET=sua_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRATION=86400000

# CORS Origins Permitidas (URLs do Frontend separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ==========================================
# RECURSOS OPCIONAIS / IA
# ==========================================
# OpenAI API Key para embeddings e geração de conteúdos IA
OPENAI_API_KEY=sua_chave_openai_aqui

# URL do banco vetorial ChromaDB (se utilizado)
CHROMA_URL=http://localhost:8000
