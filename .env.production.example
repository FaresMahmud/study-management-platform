# Production Environment Variables
# Copy this file to .env.production and fill in your values
# This file is used by docker-compose.prod.yml

# Database (PostgreSQL/Neon)
DB_NAME=study_platform
DB_USERNAME=study_user
DB_PASSWORD=your-secure-postgres-password

# Spring Datasource URL (for Neon PostgreSQL with SSL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/study_platform?sslmode=require

# Redis
# (Using internal docker network, no external config needed)

# ChromaDB
# (Using internal docker network, CHROMA_URL is set automatically in docker-compose.prod.yml)

# JWT Secret (MUST be at least 256 bits / 32 characters for HS256)
JWT_SECRET=your-super-secret-jwt-key-min-256-bits-length-here

# CORS Allowed Origins (comma-separated, no spaces)
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key

# OAuth2 - Google (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 - GitHub (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Frontend API URL (must match your production domain)
VITE_API_URL=https://api.yourdomain.com

# HikariCP Tuning (optional)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# Flyway DDL Auto (update for production, validate for stricter control)
DDL_AUTO=update